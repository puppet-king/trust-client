{
  "easycom": {
    "autoscan": true,
    "custom": {
      "ui-(.*)": "@/components/ui/ui-$1/ui-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "信任的进化",
        "navigationStyle": "custom",
        "pageOrientation": "landscape",
        "disableScroll": true
      }
    }
  ],
  "subPackages": [
    {
      "root": "pages-tournament",
      "name": "tournament",
      "pages": [
        {
          "path": "index/index",
          "style": {
            "navigationBarTitleText": "信任的进化 - 锦标赛与演化",
            "navigationStyle": "custom",
            "pageOrientation": "landscape",
            "disableScroll": true
          }
        }
      ]
    },
    {
      "root": "pages-sandbox",
      "name": "sandbox",
      "pages": [
        {
          "path": "index/index",
          "style": {
            "navigationBarTitleText": "信任的进化 - 沙盒与总结",
            "navigationStyle": "custom",
            "pageOrientation": "landscape",
            "disableScroll": true
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["pages-tournament", "pages-sandbox"]
    },
    "pages-tournament/index/index": {
      "network": "all",
      "packages": ["pages-sandbox"]
    }
  },
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "信任的进化",
    "navigationBarBackgroundColor": "#222222",
    "backgroundColor": "#222222",
    "pageOrientation": "landscape",
    "restartStrategy": "homePage"
  }
}
